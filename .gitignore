# Virtual environment
.venv/

# Python runtime artifacts
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Raw data dumps (multi-GB; re-downloadable / re-derivable)
data_raw_2023/

# Pipeline artifacts (regenerable): large data stays ignored —
# dataset/, embeddings/, checkpoints/, semantic_ids/, per-item CSVs.
# Small report files (figures, numbers, eval JSONs) ARE committed.
artifacts/*
!artifacts/audit/
!artifacts/audit_high_entropy/
!artifacts/runs/
artifacts/audit/*
!artifacts/audit/*.md
!artifacts/audit/*.json
!artifacts/audit/*.png
artifacts/audit_high_entropy/*
!artifacts/audit_high_entropy/*.md
!artifacts/audit_high_entropy/*.json
!artifacts/audit_high_entropy/*.png
artifacts/runs/*
!artifacts/runs/*.json
!artifacts/runs/*.md
